def CONSTANTS = evaluate(new File("${projectDir}/dev/constants.groovy"))

params {
    constants = CONSTANTS
    meta_merge = null
    help = false
    version = false
    outdir = "BASIL_out"
    r1 = null
    r2 = null
    reads_tsv = null
    reads_dir = null
    contigs_dir = null
    dir_depth = 1
    pe_quality_fail_rate = 40
    pe_min_length = 50
    pe_base_depth = 15
    pe_no_correction = true
    pe_extra_opt = ""
    min_genome_cov = 20
    max_genome_cov = 150
    min_contig_cov = 2
    min_contig_length = 300
    asm_used = "contigs"
    genome_size = null
    parallel_run = 1
    cpus = 8
    ram = 16
    skip_polish = false
    only_filtered = false
    only_polished = false
    clear_saved_db = null
    checkm2_db = null
    kraken2_db = null
    gtdbtk_db = null
    minid_genes = 90
    mincov_genes = 90
    mutation = null
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
    fields    = 'task_id,name,tag,status,exit,duration,realtime,%cpu,rss,vmem,rchar,wchar,workdir'
}

workDir = "${params.outdir}/work"

env {
    FONTCONFIG_PATH = '/tmp/fontconfig'
    XDG_CACHE_HOME  = '/tmp/cache'
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = "${System.getProperty('user.home')}/basil_cache"
    runOptions = '--bind /srv:/srv,/home:/home'
    pullTimeout = '2h'
}

process {
    maxForks = params.parallel_run
    cpus = params.cpus
    memory = "${params.ram} GB"
    container = 'library://samrachhan/default/basil:sha256.2a18199c81cffd0b5803e54bad0b85e68307a1163414aa24ebce28a6380b6043'

    withLabel: 'pe_qc|polish|filter' {
        conda = "${projectDir}/envs/polish_reads_tools.yml"
    }
    withLabel: 'assembly|assembly_QC' {
        conda = "${projectDir}/envs/assembly_QC.yml"
    }
    withLabel: 'read_qc_report|assembly_report|gtdbtk|kraken2_filtered|kraken2_polished|kraken2_reads|kraken2_contigs_dir|format_convert' {
        conda = "${projectDir}/envs/taxo_tools.yml"
    }
    withLabel: 'abritamr|abricate|amr_consensus|meta_merge' {
        conda = "${projectDir}/envs/amr_tools.yml"
    }
    withLabel: 'main_report' {
        conda = "${projectDir}/envs/multiqc.yml"
    }
}

profiles {
    singularity {
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.pullTimeout = '2h'
        singularity.cacheDir = "${System.getProperty('user.home')}/basil_cache"
        singularity.runOptions = '--bind /srv:/srv,/home:/home'
        process.container = 'library://samrachhan/default/basil:sha256.2a18199c81cffd0b5803e54bad0b85e68307a1163414aa24ebce28a6380b6043'
    }

    docker {
        apptainer.enabled = false
        docker.enabled = true
        docker.runOptions = '-v /srv:/srv -v /home:/home'
        process.container = 'samrachhan/basil:latest@sha256:53c6f537c2d0e94d5b01073e52a0408d601cb5532cc5de06a7f13d7525b08277'
    }
    mamba {
        apptainer.enabled = false
        conda.enabled = true
        conda.useMamba = true
        conda.cacheDir = "${System.getProperty('user.home')}/basil_cache"
        process.container = null
    }
}
